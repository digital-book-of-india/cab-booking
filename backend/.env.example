# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (admin panel). Empty = none.
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/cab_booking?replicaSet=rs0
# Max MongoDB connections per server instance (5-200).
# MONGO_MAX_POOL_SIZE=20
REDIS_URL=redis://localhost:6379

# Min 32 chars each. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-1
JWT_REFRESH_SECRET=replace-me-with-a-long-random-secret-2

# Auth tuning (defaults shown)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# Used only by `npm run seed`: phone of the first SUPER_ADMIN to create
SEED_ADMIN_PHONE=

# mock = in-process fake providers (blocked in production); live = real providers only.
# In live mode every *_DRIVER below must be non-mock or the server refuses to start.
PROVIDER_MODE=mock

# Staging/QA only (never in production): makes every login OTP this 6-digit code.
# STAGING_FIXED_OTP=123456

# ---- Integrations. Leave on mock until the credential exists; each can be switched on alone in mock mode. ----

# Push: mock = log only. fcm = real Firebase push; also set FCM_SERVICE_ACCOUNT_JSON (one line).
PUSH_DRIVER=mock
FCM_SERVICE_ACCOUNT_JSON=

# SMS (India needs a DLT-registered template): mock | nimbus. nimbus needs every SMS_* value below.
SMS_DRIVER=mock
SMS_OTP_MESSAGE=
SMS_ALERT_TEMPLATE_ID=
TRIP_LINK_BASE=
SMS_API_URL=
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=

# Maps: mock = straight-line estimate (development only) | google = Google Maps Platform.
# Needs a server-side key with Routes API, Geocoding API and Places API (New) enabled; restrict it by server IP.
MAPS_DRIVER=mock
GOOGLE_MAPS_API_KEY=

# Email: mock | smtp. smtp needs SMTP_HOST, SMTP_USER, SMTP_PASS and EMAIL_FROM.
EMAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Driver document storage: mock | local | s3.
#  local = the server's own upload folder (one server instance only; mount a persistent volume and back it up).
#  s3    = any S3-compatible service (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=mock
UPLOAD_DIR=
# Public address of this API with no path, e.g. https://api.example.com (upload links are built on it).
UPLOAD_PUBLIC_URL=
# Min 32 chars. Signs the upload/download links.
UPLOAD_SIGNING_SECRET=
# UPLOAD_MAX_BYTES=10485760
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=

# Payments: mock moves no real money; razorpay needs the three keys below (use TEST keys outside production).
PAYMENTS_DRIVER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Driver payouts: mock | razorpayx (needs all four values). AUTO_PAYOUTS=true pays approved settlements automatically.
PAYOUTS_DRIVER=mock
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
AUTO_PAYOUTS=false

# ---- Operations ----
# Where alerts go (Slack/Discord-style incoming webhook). Empty = log only.
ALERT_WEBHOOK_URL=
# Lets a metrics tool read GET /api/v1/metrics with `Authorization: Bearer <token>` (min 16 chars). Empty = off.
METRICS_TOKEN=
# Staff phone-code login: allowed outside production, refused in production.
# STAFF_OTP_LOGIN=true
STAFF_PORTAL_URL=http://localhost:3000
# GST added ON TOP of every ride fare, in basis points (500 = 5%), and GST on the platform commission
# (1800 = 18%), which the driver bears. PLACEHOLDERS: confirm both with an accountant. 0 turns one off.
RIDE_TAX_BP=500
COMMISSION_TAX_BP=1800
# Company-invoice tax in basis points. Keep 0 while RIDE_TAX_BP is on (the tax is already inside each ride).
INVOICE_TAX_BP=0

# Encrypts backups made with: npm run backup -- dump --encrypt (64 hex characters: openssl rand -hex 32).
# Keep it in a password manager, NOT beside the backups. Needed again to verify or restore.
# BACKUP_ENCRYPTION_KEY=
