# Copy to .env.staging (git-ignored) and fill in. Used twice: by docker compose (--env-file) and by the api.
# Nothing here is a real secret. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- The server ----
# DNS name that points at this server (Caddy gets the HTTPS certificate for it). No https://, no path.
API_DOMAIN=staging.example.com
LOG_LEVEL=info
# Browser origins allowed to call the API (the admin panel). No wildcard.
CORS_ORIGINS=https://admin-staging.example.com

# ---- Database: MongoDB Atlas (a replica set). Use a dedicated staging database name. ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/cab_staging?retryWrites=true&w=majority

# ---- Secrets (different values, 32+ characters each) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
UPLOAD_SIGNING_SECRET=
# Lets a tester sign in with this code instead of an SMS (staging ONLY; the server refuses it in production).
STAGING_FIXED_OTP=123456
# Lets staff sign in with a phone code on staging (the real way is email + password + authenticator).
STAFF_OTP_LOGIN=true
# Lets a metrics tool read /api/v1/metrics (16+ characters). Leave empty to switch the endpoint off.
METRICS_TOKEN=
# Where alerts go (Slack/Discord-style incoming webhook). Empty = logged only.
ALERT_WEBHOOK_URL=

# ---- Real integrations. Staging uses vendor TEST accounts. ----
PROVIDER_MODE=live

MAPS_DRIVER=google
GOOGLE_MAPS_API_KEY=

PAYMENTS_DRIVER=razorpay
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYOUTS_DRIVER=razorpayx
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
AUTO_PAYOUTS=false

SMS_DRIVER=nimbus
SMS_API_URL=
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=
SMS_OTP_MESSAGE=
SMS_ALERT_TEMPLATE_ID=
TRIP_LINK_BASE=

PUSH_DRIVER=fcm
# The Firebase service-account JSON on ONE line.
FCM_SERVICE_ACCOUNT_JSON=

EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
STAFF_PORTAL_URL=https://admin-staging.example.com

# Driver documents live on this server's disk (the "uploads" volume). Links are built on this address.
STORAGE_DRIVER=local
UPLOAD_PUBLIC_URL=https://staging.example.com
# UPLOAD_MAX_BYTES=10485760

# ---- Tax (placeholders: confirm with an accountant) ----
RIDE_TAX_BP=500
COMMISSION_TAX_BP=1800
INVOICE_TAX_BP=0
