{
  "name": "cab-booking-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cab booking platform backend (modular monolith)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed/run.ts",
    "seed:prod": "node dist/seed/run.js",
    "indexes": "tsx src/db/runIndexes.ts",
    "indexes:prod": "node dist/db/runIndexes.js",
    "postman": "tsx scripts/gen-postman.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "loadtest:rides": "tsx scripts/loadtest-rides.ts",
    "loadtest:local": "tsx scripts/localstack.ts",
    "verify:live": "tsx src/tools/verifyLiveRun.ts",
    "verify:live:prod": "node dist/tools/verifyLiveRun.js",
    "backup": "tsx src/tools/backupRun.ts",
    "backup:prod": "node dist/tools/backupRun.js",
    "uploads:sweep": "tsx src/tools/uploadSweepRun.ts",
    "uploads:sweep:prod": "node dist/tools/uploadSweepRun.js",
    "preflight": "tsx src/tools/preflightRun.ts",
    "preflight:prod": "node dist/tools/preflightRun.js",
    "gate": "vitest run --maxWorkers=3 tests/gate.test.ts tests/rbac-matrix.test.ts tests/security.test.ts tests/security-limits.test.ts tests/dispatch-race.test.ts tests/rides.test.ts tests/finance-payments.test.ts tests/finance-ledger.test.ts tests/finance-cash.test.ts tests/tips-wallet.test.ts tests/payouts.test.ts tests/safety.test.ts tests/authz.test.ts tests/contract.test.ts tests/monitor.test.ts"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
